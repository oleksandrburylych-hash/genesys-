<section class="tab talents {{tab.cssClass}}" data-tab="talents" data-group="primary">
  <section class="block heroic-block">
    <header class="list-header">
      <h3>{{localize "GENESYS.Heroic.Title"}}</h3>
      <span class="hint">{{localize "GENESYS.Heroic.Points"}}: {{heroicPoints.available}} / {{heroicPoints.total}}</span>
      {{#if editable}}
      <a class="item-control" data-action="resetHeroic" data-tooltip="GENESYS.Heroic.Reset"><i class="fa-solid fa-rotate"></i></a>
      <a class="item-control" data-action="itemCreate" data-type="heroic"><i class="fa-solid fa-plus"></i></a>
      {{/if}}
    </header>
    <ol class="compact-list">
      {{#each heroics}}
      <li data-item-id="{{id}}">
        <img src="{{img}}" alt="">
        <div class="weapon-info">
          <a class="name" data-action="itemEdit">{{name}}</a>
          {{#if upgrades}}<span class="sub">{{upgrades}}</span>{{/if}}
        </div>
        <span class="sub">{{uses}}/{{perSession}}</span>
        <button type="button" class="heroic-activate" data-action="activateHeroic" data-tooltip="GENESYS.Heroic.ActivateHint">
          <i class="fa-solid fa-bolt"></i> {{localize "GENESYS.Heroic.Activate"}} ({{storyCost}} <i class="fa-solid fa-book-open"></i>)
        </button>
      </li>
      {{else}}
      <li class="empty">{{localize "GENESYS.Heroic.None"}}</li>
      {{/each}}
    </ol>
  </section>

  <p class="hint">{{localize "GENESYS.Hint.TalentPyramid"}}</p>

  <div class="pyramid">
    {{#each talentTiers}}
    <section class="tier-block">
      <header class="list-header">
        <h3>{{localize "GENESYS.Talent.Tier"}} {{tier}} <span class="count">({{count}})</span></h3>
        {{#unless canAdd}}<span class="pyramid-warning" data-tooltip="GENESYS.Hint.PyramidBlocked"><i class="fa-solid fa-triangle-exclamation"></i></span>{{/unless}}
        {{#if @root.editable}}<a class="item-control" data-action="itemCreate" data-type="talent" data-tier="{{tier}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </header>
      <ol class="compact-list talent-list">
        {{#each talents}}
        <li class="talent" data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <a class="name" data-action="itemEdit">{{name}}</a>
          <span class="activation">{{localize activation}}</span>
          {{#if ranked}}
          <span class="talent-rank">
            {{#if @root.editable}}<a data-action="talentRank" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
            <span>{{localize "GENESYS.Rank"}} {{rank}}</span>
            {{#if @root.editable}}<a data-action="talentRank" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
          </span>
          {{/if}}
          <span class="item-controls">
            <a data-action="itemChat" data-tooltip="GENESYS.ToChat"><i class="fa-solid fa-comment"></i></a>
            {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </span>
        </li>
        {{/each}}
      </ol>
    </section>
    {{/each}}
  </div>

  <section class="block abilities-block">
    <header class="list-header">
      <h3>{{localize "GENESYS.Abilities"}}</h3>
      {{#if editable}}<a class="item-control" data-action="itemCreate" data-type="ability"><i class="fa-solid fa-plus"></i></a>{{/if}}
    </header>
    <ol class="compact-list">
      {{#each abilities}}
      <li data-item-id="{{id}}">
        <img src="{{img}}" alt="">
        <a class="name" data-action="itemEdit">{{name}}</a>
        <span class="item-controls">
          <a data-action="itemChat" data-tooltip="GENESYS.ToChat"><i class="fa-solid fa-comment"></i></a>
          {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </span>
      </li>
      {{else}}
      <li class="empty">{{localize "GENESYS.Hint.NoAbilities"}}</li>
      {{/each}}
    </ol>
  </section>
</section>

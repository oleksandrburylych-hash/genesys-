<div class="gs-top-wrap">
  <div class="gs-top">
    <div class="gs-identity">
      <div class="gs-kicker">{{localize "GENESYS.Sheet.Kicker"}}</div>
      <input class="gs-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'GENESYS.Sheet.NamePlaceholder'}}">
      <div class="gs-lines">
        <div class="gs-line">
          <label>{{localize "GENESYS.Sheet.ArchetypeLine"}}</label>
          {{#if archetype}}<a data-action="itemEdit" data-item-id="{{archetype.id}}">{{archetype.name}}</a>
          {{else}}<span class="gs-placeholder">{{localize "GENESYS.Hint.DropArchetype"}}</span>{{/if}}
        </div>
        <div class="gs-line">
          <label>{{localize "TYPES.Item.career"}}</label>
          {{#if career}}<a data-action="itemEdit" data-item-id="{{career.id}}">{{career.name}}</a>
          {{else}}<span class="gs-placeholder">{{localize "GENESYS.Hint.DropCareer"}}</span>{{/if}}
        </div>
        <div class="gs-line">
          <label>{{localize "GENESYS.Sheet.Player"}}</label>
          <span>{{playerName}}</span>
        </div>
        {{#if adventureLabel}}
        <div class="gs-line">
          <label>{{localize "GENESYS.Wizard.Adventure"}}</label>
          <span>{{adventureLabel}}</span>
        </div>
        {{/if}}
      </div>
      <div class="gs-toolbar">
        {{#if system.creation}}
        <button type="button" class="gs-btn gs-btn-gold" data-action="creationWizard" data-tooltip="GENESYS.Wizard.Hint">
          <i class="fa-solid fa-hat-wizard"></i> {{localize "GENESYS.Sheet.Wizard"}}
        </button>
        {{/if}}
        <button type="button" class="gs-btn {{#if system.creation}}gs-btn-maroon{{/if}}" data-action="finishCreation"
                data-tooltip="{{#if system.creation}}GENESYS.Creation.FinishHint{{else}}GENESYS.Creation.ReopenHint{{/if}}">
          <i class="fa-solid {{#if system.creation}}fa-hammer{{else}}fa-check{{/if}}"></i>
          {{#if system.creation}}{{localize "GENESYS.Creation.Mode"}}{{else}}{{localize "GENESYS.Creation.Done"}}{{/if}}
        </button>
        <span class="gs-toolbar-sep"></span>
        <a class="gs-icon-btn" data-action="rollPool" data-tooltip="GENESYS.Roll.Title"><i class="fa-solid fa-dice-d20"></i></a>
        <a class="gs-icon-btn" data-action="recoverStrain" data-tooltip="GENESYS.Rest.RecoverHint"><i class="fa-solid fa-mug-hot"></i></a>
        <a class="gs-icon-btn" data-action="restOvernight" data-tooltip="GENESYS.Rest.OvernightHint"><i class="fa-solid fa-bed"></i></a>
        <a class="gs-icon-btn gs-pk-btn {{#unless painkillers.count}}empty{{/unless}}" data-action="painkiller" data-tooltip="{{painkillers.tooltip}}"><i class="fa-solid fa-pills"></i>{{#if painkillers.count}}<span class="gs-pk-count">{{painkillers.count}}</span>{{/if}}</a>
        <a class="gs-icon-btn" data-action="workshop" data-tooltip="GENESYS.Workshop.Title"><i class="fa-solid fa-hammer"></i></a>
        <span class="gs-toolbar-sep"></span>
        <a class="gs-icon-btn" data-action="exportChar" data-tooltip="GENESYS.Sheet.ExportHint"><i class="fa-solid fa-file-export"></i></a>
        {{#if editable}}<a class="gs-icon-btn" data-action="importChar" data-tooltip="GENESYS.Sheet.ImportHint"><i class="fa-solid fa-file-import"></i></a>{{/if}}
      </div>
    </div>

    <div class="gs-portrait">
      <img src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage" data-tooltip="GENESYS.Sheet.PortraitHint">
      {{> "systems/genesys-rpg/templates/parts/statuses.hbs"}}
    </div>

    <div class="gs-xp-col">
      <div class="gs-xp-banner">
        <span class="gs-xp-value">{{system.experience.total}}</span>
        <span class="gs-xp-label">{{localize "GENESYS.Sheet.XPTotal"}}</span>
      </div>
      <div class="gs-xp-banner {{#if (lt system.experience.available 0)}}negative{{/if}}">
        <span class="gs-xp-value">{{system.experience.available}}</span>
        <span class="gs-xp-label">{{localize "GENESYS.Sheet.XPAvailable"}}</span>
      </div>
    </div>
  </div>

  <div class="gs-derived">
    <div class="gs-shield">
      <div class="gs-shield-title">{{localize "GENESYS.Soak"}}</div>
      <div class="gs-shield-body"><span class="gs-big" data-tooltip="GENESYS.Sheet.SoakHint">{{system.soak.value}}</span></div>
      <div class="gs-shield-foot"><span>&nbsp;</span></div>
    </div>

    <div class="gs-shield {{#if system.wounds.critical}}critical{{/if}}">
      <div class="gs-shield-title">{{localize "GENESYS.Wounds"}}</div>
      <div class="gs-shield-body split">
        <span class="gs-big" data-tooltip="GENESYS.Hint.WoundThreshold">{{system.wounds.max}}</span>
        <span class="gs-current">
          <a data-action="adjust" data-path="system.wounds.value" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
          <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" data-dtype="Number">
          <a data-action="adjust" data-path="system.wounds.value" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        </span>
      </div>
      <div class="gs-shield-foot split"><span>{{localize "GENESYS.Sheet.Threshold"}}</span><span>{{localize "GENESYS.Sheet.Current"}}</span></div>
    </div>

    <div class="gs-shield {{#if system.strain.critical}}critical{{/if}}">
      <div class="gs-shield-title">{{localize "GENESYS.Strain"}}</div>
      <div class="gs-shield-body split">
        <span class="gs-big" data-tooltip="GENESYS.Hint.StrainThreshold">{{system.strain.max}}</span>
        <span class="gs-current">
          <a data-action="adjust" data-path="system.strain.value" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
          <input type="number" name="system.strain.value" value="{{system.strain.value}}" min="0" data-dtype="Number">
          <a data-action="adjust" data-path="system.strain.value" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        </span>
      </div>
      <div class="gs-shield-foot split"><span>{{localize "GENESYS.Sheet.Threshold"}}</span><span>{{localize "GENESYS.Sheet.Current"}}</span></div>
    </div>

    <div class="gs-shield">
      <div class="gs-shield-title">{{localize "GENESYS.Defense"}}</div>
      <div class="gs-shield-body split">
        <span class="gs-big" data-tooltip="GENESYS.DefenseMelee">{{system.defense.melee.value}}</span>
        <span class="gs-big" data-tooltip="GENESYS.DefenseRanged">{{system.defense.ranged.value}}</span>
      </div>
      <div class="gs-shield-foot split"><span>{{localize "GENESYS.Sheet.Melee"}}</span><span>{{localize "GENESYS.Sheet.Ranged"}}</span></div>
    </div>
  </div>

  <div class="gs-ribbon"><span>{{localize "GENESYS.Sheet.Characteristics"}}</span></div>
  <div class="gs-chars">
    {{#each characteristics}}
    <div class="gs-char">
      <a class="gs-char-circle" data-action="rollCharacteristic" data-key="{{key}}" data-tooltip="GENESYS.Hint.RollCharacteristic">{{value}}</a>
      <div class="gs-char-name">{{localize label}}</div>
      {{#if @root.system.creation}}
      <div class="gs-char-ctrl">
        <a data-action="charChange" data-key="{{key}}" data-delta="-1" data-tooltip="GENESYS.Sheet.CharDown"><i class="fa-solid fa-minus"></i></a>
        <a data-action="charChange" data-key="{{key}}" data-delta="1" data-tooltip="GENESYS.Sheet.CharUp"><i class="fa-solid fa-plus"></i></a>
      </div>
      {{/if}}
    </div>
    {{/each}}
  </div>
</div>

<div class="sheet-top">
<header class="genesys-header">
  <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage" title="{{actor.name}}">
  <div class="header-main">
    <div class="name-row">
      <input class="actor-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'GENESYS.Name'}}">
      <div class="xp-badge {{#if (lt system.experience.available 0)}}negative{{/if}}" data-tooltip="GENESYS.XP.AvailableHint">
        <span class="label">{{localize "GENESYS.XP.Available"}}</span>
        <span class="value">{{system.experience.available}}</span>
        <span class="total">/ {{system.experience.total}}</span>
      </div>
    </div>

    <div class="origin-row">
      <div class="origin {{#unless archetype}}empty{{/unless}}">
        <span class="label">{{localize "TYPES.Item.archetype"}}</span>
        {{#if archetype}}
          <a data-action="itemEdit" data-item-id="{{archetype.id}}">{{archetype.name}}</a>
        {{else}}
          <span class="hint">{{localize "GENESYS.Hint.DropArchetype"}}</span>
        {{/if}}
      </div>
      <div class="origin {{#unless career}}empty{{/unless}}">
        <span class="label">{{localize "TYPES.Item.career"}}</span>
        {{#if career}}
          <a data-action="itemEdit" data-item-id="{{career.id}}">{{career.name}}</a>
        {{else}}
          <span class="hint">{{localize "GENESYS.Hint.DropCareer"}}</span>
        {{/if}}
      </div>
      {{#if system.creation}}<button type="button" class="creation-wizard" data-action="creationWizard" data-tooltip="GENESYS.Wizard.Hint"><i class="fa-solid fa-hat-wizard"></i></button>{{/if}}
      <button type="button" class="creation-toggle {{#if system.creation}}active{{/if}}" data-action="finishCreation"
              data-tooltip="{{#if system.creation}}GENESYS.Creation.FinishHint{{else}}GENESYS.Creation.ReopenHint{{/if}}">
        <i class="fa-solid {{#if system.creation}}fa-hammer{{else}}fa-check{{/if}}"></i>
        {{#if system.creation}}{{localize "GENESYS.Creation.Mode"}}{{else}}{{localize "GENESYS.Creation.Done"}}{{/if}}
      </button>
    </div>

    <div class="characteristics">
      {{#each characteristics}}
      <div class="characteristic">
        <a class="char-value rollable" data-action="rollCharacteristic" data-key="{{key}}" data-tooltip="GENESYS.Hint.RollCharacteristic">{{value}}</a>
        <span class="char-label">{{localize label}}</span>
        {{#if @root.system.creation}}
        <div class="char-controls">
          <a data-action="charChange" data-key="{{key}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
          <a data-action="charChange" data-key="{{key}}" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</header>

<section class="derived-stats">
  <div class="stat soak">
    <span class="stat-label">{{localize "GENESYS.Soak"}}</span>
    <span class="stat-value">{{system.soak.value}}</span>
  </div>

  <div class="stat track {{#if system.wounds.critical}}critical{{/if}}">
    <span class="stat-label">{{localize "GENESYS.Wounds"}}</span>
    <div class="track-values">
      <a data-action="adjust" data-path="system.wounds.value" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
      <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" data-dtype="Number">
      <span class="sep">/</span>
      <span class="max" data-tooltip="GENESYS.Hint.WoundThreshold">{{system.wounds.max}}</span>
      <a data-action="adjust" data-path="system.wounds.value" data-delta="1"><i class="fa-solid fa-plus"></i></a>
    </div>
  </div>

  <div class="stat track {{#if system.strain.critical}}critical{{/if}}">
    <span class="stat-label">{{localize "GENESYS.Strain"}}</span>
    <div class="track-values">
      <a data-action="adjust" data-path="system.strain.value" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
      <input type="number" name="system.strain.value" value="{{system.strain.value}}" min="0" data-dtype="Number">
      <span class="sep">/</span>
      <span class="max" data-tooltip="GENESYS.Hint.StrainThreshold">{{system.strain.max}}</span>
      <a data-action="adjust" data-path="system.strain.value" data-delta="1"><i class="fa-solid fa-plus"></i></a>
    </div>
  </div>

  <div class="stat defense">
    <span class="stat-label">{{localize "GENESYS.Defense"}}</span>
    <div class="defense-values">
      <span data-tooltip="GENESYS.DefenseMelee"><i class="fa-solid fa-hand-fist"></i> {{system.defense.melee.value}}</span>
      <span data-tooltip="GENESYS.DefenseRanged"><i class="fa-solid fa-bullseye"></i> {{system.defense.ranged.value}}</span>
    </div>
  </div>

  <div class="stat quick-actions">
    <a data-action="rollPool" data-tooltip="GENESYS.Roll.Title"><i class="fa-solid fa-dice-d20"></i></a>
    <a data-action="recoverStrain" data-tooltip="GENESYS.Rest.RecoverHint"><i class="fa-solid fa-mug-hot"></i></a>
    <a data-action="restOvernight" data-tooltip="GENESYS.Rest.OvernightHint"><i class="fa-solid fa-bed"></i></a>
  </div>
</section>
</div>

<div class="world-setup">
  <div class="setup-body">
    <p class="hint">{{localize "GENESYS.Setup.Intro"}}</p>

    <h3 class="ws-title"><span>1</span> {{localize "GENESYS.Setup.Adventures"}}</h3>
    <p class="hint">{{localize "GENESYS.Setup.AdventuresHint"}}</p>
    <div class="ws-adventures">
      {{#each adventures}}
      <button type="button" class="ws-adv {{#if selected}}selected{{/if}}" data-action="adventure" data-key="{{key}}">
        <img src="{{img}}" alt="">
        <span class="ws-adv-body">
          <strong>{{label}}</strong>
          <span class="ws-adv-hint">{{hint}}</span>
          <span class="ws-adv-counts">{{localize "GENESYS.Setup.CountRaces"}} {{archetypes}} · {{localize "GENESYS.Setup.CountCareers"}} {{careers}} · {{localize "GENESYS.Setup.CountFoes"}} {{adversaries}} · {{localize "GENESYS.Setup.CountTotal"}} {{total}}</span>
        </span>
        <i class="ws-check fa-solid {{#if selected}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
      </button>
      {{/each}}
    </div>

    <div class="ws-custom {{#if customActive}}selected{{/if}}">
      <img src="{{customImg}}" alt="">
      <div>
        <strong>{{localize "GENESYS.Setup.Custom"}}</strong>
        <p class="hint">{{localize "GENESYS.Setup.CustomHint"}}</p>
        <div class="ws-worlds">
          {{#each worlds}}
          <button type="button" class="gs-world {{#if on}}on{{/if}}" style="--world: {{color}}" data-action="world" data-key="{{key}}">{{label}}</button>
          {{/each}}
        </div>
        <div class="ws-custom-fields">
          <label>{{localize "GENESYS.Setup.CustomName"}} <input type="text" name="custom.name" value="{{customName}}" placeholder="{{localize 'GENESYS.Setup.CustomNamePh'}}"></label>
          <label>{{localize "GENESYS.Setup.CustomSkills"}} <select name="custom.skills">{{#each skillSets}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}</select></label>
        </div>
      </div>
    </div>

    <div class="ws-chosen {{#if nothingChosen}}empty{{/if}}">
      {{#if nothingChosen}}<i class="fa-solid fa-triangle-exclamation"></i> {{localize "GENESYS.Setup.PickAdventure"}}
      {{else}}<i class="fa-solid fa-map"></i> {{localize "GENESYS.Setup.Chosen"}}: <strong>{{chosenLabels}}</strong>{{/if}}
    </div>

    <h3 class="ws-title"><span>2</span> {{localize "GENESYS.Setup.Books"}}</h3>
    <div class="setup-grid">
      {{#each sources}}<label class="checkbox"><input type="checkbox" name="sources.{{key}}" {{checked checked}}> {{label}}</label>{{/each}}
    </div>
    <h4 class="ws-sub">{{localize "GENESYS.Setup.FanBooks"}}</h4>
    <div class="setup-grid">
      {{#each fanSources}}<label class="checkbox"><input type="checkbox" name="sources.{{key}}" {{checked checked}}> {{label}}</label>{{/each}}
    </div>
    <h4 class="ws-sub">{{localize "GENESYS.Setup.Modules"}}</h4>
    <div class="ws-modules">
      {{#each modules}}
      <label class="ws-module {{#if checked}}on{{/if}}"><input type="checkbox" name="sources.{{key}}" {{checked checked}}>
        <span><b>{{localize label}}</b> <span class="hint">({{count}})</span><br><span class="hint">{{localize hint}}</span></span></label>
      {{/each}}
    </div>

    <h3 class="ws-title"><span>3</span> {{localize "GENESYS.Setup.Import"}}</h3>
    <p class="hint">{{localize "GENESYS.Setup.ImportHint"}}</p>
    <div class="setup-grid">
      {{#each packs}}<label class="checkbox"><input type="checkbox" name="packs.{{key}}" {{checked checked}}> {{label}} <span class="hint">({{count}} {{localize "GENESYS.Setup.Of"}} {{total}})</span></label>{{/each}}
    </div>
    <label class="checkbox"><input type="checkbox" name="replace" {{checked state.replace}}> {{localize "GENESYS.Setup.Replace"}}</label>

    <h3 class="ws-title"><span>4</span> {{localize "GENESYS.Setup.Extras"}}</h3>
    <div class="setup-grid">
      <label class="checkbox"><input type="checkbox" name="tables" {{checked state.tables}}> {{localize "GENESYS.Setup.Tables"}}</label>
      <label class="checkbox"><input type="checkbox" name="journal" {{checked state.journal}}> {{localize "GENESYS.Setup.Journal"}}</label>
      <label class="checkbox"><input type="checkbox" name="macros" {{checked state.macros}}> {{localize "GENESYS.Setup.Macros"}}</label>
      <label class="checkbox"><input type="checkbox" name="storyPoints" {{checked state.storyPoints}}> {{localize "GENESYS.Setup.StoryPoints"}}</label>
    </div>

    {{#if log.length}}
    <ol class="setup-log">{{#each log}}<li>{{this}}</li>{{/each}}</ol>
    {{/if}}
  </div>
  <footer class="form-footer">
    <span class="ws-total">{{localize "GENESYS.Setup.WillImport"}}: <strong>{{selectedTotal}}</strong></span>
    <button type="button" data-action="skip" {{#if running}}disabled{{/if}}>{{localize "GENESYS.Setup.Skip"}}</button>
    <button type="button" data-action="install" class="roll-button" {{#if running}}disabled{{/if}}>
      <i class="fa-solid {{#if running}}fa-spinner fa-spin{{else}}fa-wand-magic-sparkles{{/if}}"></i> {{localize "GENESYS.Setup.Install"}}
    </button>
  </footer>
</div>

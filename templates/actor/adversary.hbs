<div class="adversary-sheet">
  <header class="genesys-header adversary-header">
    <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage">
    <div class="header-main">
      <div class="name-row">
        <input class="actor-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'GENESYS.Name'}}">
        <select name="system.adversaryType" class="adversary-type">
          {{selectOptions adversaryTypes selected=system.adversaryType localize=true}}
        </select>
        <a class="pool-button" data-action="rollPool" data-tooltip="GENESYS.Roll.Title"><i class="fa-solid fa-dice-d20"></i></a>
      </div>

      <div class="characteristics">
        {{#each characteristics}}
        <div class="characteristic">
          <input class="char-input" type="number" name="system.characteristics.{{key}}.value" value="{{value}}" min="1" max="6" data-dtype="Number">
          <a class="char-label rollable" data-action="rollCharacteristic" data-key="{{key}}">{{localize label}}</a>
        </div>
        {{/each}}
      </div>
    </div>
  </header>

  <section class="derived-stats adversary-stats">
    <div class="stat">
      <span class="stat-label">{{localize "GENESYS.Soak"}}</span>
      <input type="number" name="system.soak.value" value="{{system.soak.value}}" data-dtype="Number">
    </div>
    <div class="stat track">
      <span class="stat-label">{{localize "GENESYS.Wounds"}}{{#if isMinion}} ({{localize "GENESYS.PerMinion"}}){{/if}}</span>
      <div class="track-values">
        <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" data-dtype="Number">
        <span class="sep">/</span>
        <input type="number" name="system.wounds.max" value="{{system.wounds.max}}" data-dtype="Number">
      </div>
    </div>
    {{#if isNemesis}}
    <div class="stat track">
      <span class="stat-label">{{localize "GENESYS.Strain"}}</span>
      <div class="track-values">
        <input type="number" name="system.strain.value" value="{{system.strain.value}}" data-dtype="Number">
        <span class="sep">/</span>
        <input type="number" name="system.strain.max" value="{{system.strain.max}}" data-dtype="Number">
      </div>
    </div>
    {{/if}}
    <div class="stat defense">
      <span class="stat-label">{{localize "GENESYS.Defense"}}</span>
      <div class="defense-values">
        <input type="number" name="system.defense.melee.value" value="{{system.defense.melee.value}}" data-dtype="Number" data-tooltip="GENESYS.DefenseMelee">
        <input type="number" name="system.defense.ranged.value" value="{{system.defense.ranged.value}}" data-dtype="Number" data-tooltip="GENESYS.DefenseRanged">
      </div>
    </div>
    {{#if isMinion}}
    <div class="stat">
      <span class="stat-label">{{localize "GENESYS.GroupSize"}}</span>
      <input type="number" name="system.groupSize" value="{{system.groupSize}}" min="1" data-dtype="Number">
      <span class="sub">{{localize "GENESYS.Alive"}}: {{system.aliveMinions}} · {{localize "GENESYS.GroupWounds"}}: {{system.groupWounds}}</span>
    </div>
    {{/if}}
  </section>

  <div class="adversary-body">
    {{#if isMinion}}<p class="hint">{{localize "GENESYS.Hint.MinionSkills"}}</p>{{/if}}
    {{> "systems/genesys-rpg/templates/actor/parts/skill-list.hbs"}}

    <section class="block">
      <header class="list-header">
        <h3>{{localize "GENESYS.Weapons"}}</h3>
        {{#if editable}}<a class="item-control" data-action="itemCreate" data-type="weapon"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </header>
      <ol class="compact-list">
        {{#each weapons}}
        <li class="weapon" data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <div class="weapon-info">
            <a class="rollable name" data-action="rollWeapon">{{name}}</a>
            <span class="sub">{{skillName}} · {{localize "GENESYS.DamageShort"}} {{damage}} · {{localize "GENESYS.CritShort"}} {{crit}} · {{localize range}}</span>
            {{#if qualities}}<span class="sub qualities">{{qualities}}</span>{{/if}}
          </div>
          <span class="skill-pool">{{#each pool}}{{genesysDie key label}}{{/each}}</span>
          <span class="item-controls">
            <a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a>
            {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </span>
        </li>
        {{/each}}
      </ol>
    </section>

    <section class="block">
      <header class="list-header">
        <h3>{{localize "GENESYS.TalentsAndAbilities"}}</h3>
        {{#if editable}}
        <a class="item-control" data-action="itemCreate" data-type="talent" data-tooltip="TYPES.Item.talent"><i class="fa-solid fa-star"></i></a>
        <a class="item-control" data-action="itemCreate" data-type="ability" data-tooltip="TYPES.Item.ability"><i class="fa-solid fa-plus"></i></a>
        {{/if}}
      </header>
      <ol class="compact-list">
        {{#each talents}}
        <li data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <a class="name" data-action="itemEdit">{{name}}{{#if system.ranked}} {{system.rank}}{{/if}}</a>
          <span class="item-controls">
            <a data-action="itemChat"><i class="fa-solid fa-comment"></i></a>
            {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </span>
        </li>
        {{/each}}
        {{#each abilities}}
        <li data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <a class="name" data-action="itemEdit">{{name}}</a>
          <span class="item-controls">
            <a data-action="itemChat"><i class="fa-solid fa-comment"></i></a>
            {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </span>
        </li>
        {{/each}}
      </ol>
    </section>

    <section class="block">
      <header class="list-header">
        <h3>{{localize "GENESYS.Equipment"}}</h3>
        {{#if editable}}
        <a class="item-control" data-action="itemCreate" data-type="armor" data-tooltip="TYPES.Item.armor"><i class="fa-solid fa-shirt"></i></a>
        <a class="item-control" data-action="itemCreate" data-type="gear" data-tooltip="TYPES.Item.gear"><i class="fa-solid fa-plus"></i></a>
        {{/if}}
      </header>
      <ol class="compact-list">
        {{#each armor}}
        <li data-item-id="{{id}}"><img src="{{img}}" alt=""><a class="name" data-action="itemEdit">{{name}}</a>
          <span class="item-controls">{{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}</span></li>
        {{/each}}
        {{#each gear}}
        <li data-item-id="{{id}}"><img src="{{img}}" alt=""><a class="name" data-action="itemEdit">{{name}}</a>
          <span class="item-controls">{{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}</span></li>
        {{/each}}
      </ol>
    </section>

    <section class="block editor-block">
      <header class="list-header"><h3>{{localize "GENESYS.Description"}}</h3></header>
      {{formInput systemFields.description name="system.description" enriched=enriched.description value=system.description toggled=true}}
    </section>
  </div>
</div>

<section class="item-details grid-2">
  <div class="form-group"><label>{{localize "GENESYS.CharacteristicLabel"}}</label>
    <select name="system.characteristic">{{selectOptions choices.characteristics selected=system.characteristic localize=true}}</select></div>
  <div class="form-group"><label>{{localize "GENESYS.Category"}}</label>
    <select name="system.category">{{selectOptions choices.skillCategories selected=system.category localize=true}}</select></div>
  <div class="form-group"><label>{{localize "GENESYS.Rank"}}</label>
    <input type="number" name="system.rank" value="{{system.rank}}" min="0" max="5" data-dtype="Number"></div>
  <div class="form-group"><label>{{localize "GENESYS.CareerSkill"}}</label>
    <input type="checkbox" name="system.career" {{checked system.career}}></div>
  <div class="form-group"><label>{{localize "GENESYS.Key"}}</label>
    <input type="text" name="system.key" value="{{system.key}}" placeholder="vigilance" data-tooltip="GENESYS.Hint.SkillKey"></div>
</section>

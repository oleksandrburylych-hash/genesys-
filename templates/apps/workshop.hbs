<div class="ws">
  <div class="gm-split">
    <div class="gm-browser">
      <div class="gm-filters">
        {{#each modes}}<a class="wz-chip {{#if active}}active{{/if}}" data-action="mode" data-mode="{{key}}">{{localize label}}</a>{{/each}}
        <input type="text" name="search" value="{{search}}" placeholder="{{localize 'GENESYS.Wizard.Search'}}">
      </div>
      <div class="gm-list ws-list">
        {{#each list}}
        <a class="gm-row {{#if selected}}selected{{/if}}" data-action="select" data-uuid="{{uuid}}">
          <img src="{{img}}" alt="">
          <div class="gm-row-text"><span class="gm-row-name">{{name}}</span>
            <span class="gm-row-sub">{{localize "GENESYS.Rarity"}} {{rarity}} · {{localize "GENESYS.Price"}} {{price}}</span></div>
        </a>
        {{else}}<p class="gs-empty">{{localize "GENESYS.Wizard.Nothing"}}</p>{{/each}}
      </div>
    </div>
    <div class="gm-encounter">
      {{#if item}}
      <div class="wz-detail-head"><img src="{{item.img}}" alt=""><div><h3>{{item.name}}</h3>
        <span class="wz-card-group">{{localize "GENESYS.Rarity"}} {{item.rarity}} · {{localize "GENESYS.Price"}} {{item.price}}</span></div></div>
      <table class="gm-table">
        <tr><td>{{localize "GENESYS.Workshop.Check"}}</td><td><b>{{skillName}}</b>, {{localize difficultyLabel}}</td></tr>
        <tr><td>{{localize "GENESYS.Workshop.Time"}}</td><td>{{plan.time}}</td></tr>
        <tr class="ws-cost"><td>{{localize "GENESYS.Workshop.Materials"}}</td><td><b>{{plan.cost}}</b> {{localize "GENESYS.Loot.Coins"}} <span class="hint">({{localize "GENESYS.Workshop.HalfPrice"}} {{item.price}})</span></td></tr>
        <tr><td>{{localize "GENESYS.Workshop.Wallet"}}</td><td>{{money}}</td></tr>
        {{#if alchemy}}<tr><td>{{localize "GENESYS.Workshop.Ingredients"}}</td><td>{{localize "GENESYS.Rarity"}} {{plan.ingredientRarity}}</td></tr>{{/if}}
      </table>
      {{#if isGM}}<label class="checkbox"><input type="checkbox" name="payMaterials" {{checked payMaterials}}> {{localize "GENESYS.Workshop.Pay"}} <span class="hint">({{localize "GENESYS.Workshop.PayGM"}})</span></label>{{/if}}
      <p class="hint">{{localize "GENESYS.Workshop.SaleNote"}}</p>
      <div class="gm-actions">
        <button type="button" class="gm-primary" data-action="craft"><i class="fa-solid fa-hammer"></i> {{localize "GENESYS.Workshop.Craft"}}</button>
        {{#if alchemy}}<button type="button" data-action="gather"><i class="fa-solid fa-leaf"></i> {{localize "GENESYS.Workshop.Gather"}}</button>{{/if}}
      </div>
      {{else}}<p class="gs-empty">{{localize "GENESYS.Workshop.Pick"}}</p>{{/if}}
      <p class="hint">{{localize "GENESYS.Workshop.Hint"}}</p>
    </div>
  </div>
</div>

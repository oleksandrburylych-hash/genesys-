<div class="adversary-sheet gs-adv type-{{system.adversaryType}}">
  <header class="gs-adv-head">
    <img class="gs-adv-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage">
    <div class="gs-adv-main">
      <div class="gs-adv-title">
        <input class="gs-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'GENESYS.Name'}}">
        <a class="gs-icon-btn" data-action="rollPool" data-tooltip="GENESYS.Roll.Title"><i class="fa-solid fa-dice-d20"></i></a>
      </div>
      <div class="gs-adv-type">
        <select name="system.adversaryType" class="gs-adv-badge">{{selectOptions adversaryTypes selected=system.adversaryType localize=true}}</select>
        {{#if threat}}<span class="gs-adv-threat" data-tooltip="GENESYS.GM.ThreatHint"><i class="fa-solid fa-skull"></i> {{localize "GENESYS.GM.Threat"}} {{threat}}</span>{{/if}}
      </div>
      {{> "systems/genesys-rpg/templates/parts/creature.hbs"}}
      {{> "systems/genesys-rpg/templates/parts/worlds.hbs"}}
      {{> "systems/genesys-rpg/templates/parts/statuses.hbs"}}
    </div>
  </header>

  <div class="gs-derived">
    <div class="gs-shield">
      <div class="gs-shield-title">{{localize "GENESYS.Soak"}}</div>
      <div class="gs-shield-body"><input class="gs-big-input" type="number" name="system.soak.value" value="{{system.soak.value}}" data-dtype="Number"></div>
      <div class="gs-shield-foot"><span>&nbsp;</span></div>
    </div>
    <div class="gs-shield {{#if woundsOver}}critical{{/if}}">
      <div class="gs-shield-title">{{localize "GENESYS.Wounds"}}{{#if isMinion}} ×{{system.groupSize}}{{/if}}</div>
      <div class="gs-shield-body split">
        <input class="gs-big-input" type="number" name="system.wounds.max" value="{{system.wounds.max}}" data-dtype="Number" data-tooltip="{{#if isMinion}}GENESYS.PerMinion{{else}}GENESYS.Sheet.Threshold{{/if}}">
        <span class="gs-current">
          <a data-action="advAdjust" data-path="system.wounds.value" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
          <input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" data-dtype="Number">
          <a data-action="advAdjust" data-path="system.wounds.value" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        </span>
      </div>
      <div class="gs-shield-foot split"><span>{{#if isMinion}}{{localize "GENESYS.PerMinion"}}{{else}}{{localize "GENESYS.Sheet.Threshold"}}{{/if}}</span><span>{{localize "GENESYS.Sheet.Current"}}</span></div>
    </div>
    {{#if isNemesis}}
    <div class="gs-shield">
      <div class="gs-shield-title">{{localize "GENESYS.Strain"}}</div>
      <div class="gs-shield-body split">
        <input class="gs-big-input" type="number" name="system.strain.max" value="{{system.strain.max}}" data-dtype="Number">
        <span class="gs-current">
          <a data-action="advAdjust" data-path="system.strain.value" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
          <input type="number" name="system.strain.value" value="{{system.strain.value}}" min="0" data-dtype="Number">
          <a data-action="advAdjust" data-path="system.strain.value" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        </span>
      </div>
      <div class="gs-shield-foot split"><span>{{localize "GENESYS.Sheet.Threshold"}}</span><span>{{localize "GENESYS.Sheet.Current"}}</span></div>
    </div>
    {{/if}}
    <div class="gs-shield">
      <div class="gs-shield-title">{{localize "GENESYS.Defense"}}</div>
      <div class="gs-shield-body split">
        <input class="gs-big-input" type="number" name="system.defense.melee.value" value="{{system.defense.melee.value}}" data-dtype="Number" data-tooltip="GENESYS.DefenseMelee">
        <input class="gs-big-input" type="number" name="system.defense.ranged.value" value="{{system.defense.ranged.value}}" data-dtype="Number" data-tooltip="GENESYS.DefenseRanged">
      </div>
      <div class="gs-shield-foot split"><span>{{localize "GENESYS.Sheet.Melee"}}</span><span>{{localize "GENESYS.Sheet.Ranged"}}</span></div>
    </div>
    {{#if isMinion}}
    <div class="gs-shield minion">
      <div class="gs-shield-title">{{localize "GENESYS.GroupSize"}}</div>
      <div class="gs-shield-body split">
        <input class="gs-big-input" type="number" name="system.groupSize" value="{{system.groupSize}}" min="1" data-dtype="Number">
        <span class="gs-big" data-tooltip="GENESYS.Alive">{{system.aliveMinions}}</span>
      </div>
      <div class="gs-shield-foot split"><span>{{localize "GENESYS.GroupSize"}}</span><span>{{localize "GENESYS.Alive"}}</span></div>
    </div>
    {{/if}}
  </div>

  <div class="gs-ribbon"><span>{{localize "GENESYS.Sheet.Characteristics"}}</span></div>
  <div class="gs-chars">
    {{#each characteristics}}
    <div class="gs-char">
      <input class="gs-char-circle gs-char-input" type="number" name="system.characteristics.{{key}}.value" value="{{value}}" min="1" max="6" data-dtype="Number">
      <a class="gs-char-name" data-action="rollCharacteristic" data-key="{{key}}" data-tooltip="GENESYS.Hint.RollCharacteristic">{{localize label}}</a>
    </div>
    {{/each}}
  </div>

  <div class="adversary-body">
    {{#if isMinion}}<p class="hint">{{localize "GENESYS.Hint.MinionSkills"}}</p>{{/if}}
    {{> "systems/genesys-rpg/templates/actor/parts/skill-list.hbs"}}

    <section class="block">
      <header class="list-header">
        <h3>{{localize "GENESYS.Weapons"}}</h3>
        {{#if editable}}<a class="item-control" data-action="itemCreate" data-type="weapon"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </header>
      <ol class="compact-list">
        {{#each weapons}}
        <li class="weapon" data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <div class="weapon-info">
            <a class="rollable name" data-action="rollWeapon">{{name}}</a>
            <span class="sub">{{skillName}} · {{localize "GENESYS.DamageShort"}} {{damage}} · {{localize "GENESYS.CritShort"}} {{crit}} · {{localize range}}</span>
            {{#if qualities}}<span class="sub qualities">{{qualities}}</span>{{/if}}
          </div>
          <span class="skill-pool">{{#each pool}}{{genesysDie key label}}{{/each}}</span>
          <span class="item-controls">
            <a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a>
            {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </span>
        </li>
        {{/each}}
      </ol>
    </section>

    <section class="block">
      <header class="list-header">
        <h3>{{localize "GENESYS.TalentsAndAbilities"}}</h3>
        {{#if editable}}
        <a class="item-control" data-action="itemCreate" data-type="talent" data-tooltip="TYPES.Item.talent"><i class="fa-solid fa-star"></i></a>
        <a class="item-control" data-action="itemCreate" data-type="ability" data-tooltip="TYPES.Item.ability"><i class="fa-solid fa-plus"></i></a>
        {{/if}}
      </header>
      <ol class="compact-list">
        {{#each talents}}
        <li data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <a class="name" data-action="itemEdit">{{name}}{{#if system.ranked}} {{system.rank}}{{/if}}</a>
          <span class="item-controls">
            <a data-action="itemChat"><i class="fa-solid fa-comment"></i></a>
            {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </span>
        </li>
        {{/each}}
        {{#each abilities}}
        <li data-item-id="{{id}}">
          <img src="{{img}}" alt="">
          <a class="name" data-action="itemEdit">{{name}}</a>
          <span class="item-controls">
            <a data-action="itemChat"><i class="fa-solid fa-comment"></i></a>
            {{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}
          </span>
        </li>
        {{/each}}
      </ol>
    </section>

    <section class="block">
      <header class="list-header">
        <h3>{{localize "GENESYS.Equipment"}}</h3>
        {{#if editable}}
        <a class="item-control" data-action="itemCreate" data-type="armor" data-tooltip="TYPES.Item.armor"><i class="fa-solid fa-shirt"></i></a>
        <a class="item-control" data-action="itemCreate" data-type="gear" data-tooltip="TYPES.Item.gear"><i class="fa-solid fa-plus"></i></a>
        {{/if}}
      </header>
      <ol class="compact-list">
        {{#each armor}}
        <li data-item-id="{{id}}"><img src="{{img}}" alt=""><a class="name" data-action="itemEdit">{{name}}</a>
          <span class="item-controls">{{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}</span></li>
        {{/each}}
        {{#each gear}}
        <li data-item-id="{{id}}"><img src="{{img}}" alt=""><a class="name" data-action="itemEdit">{{name}}</a>
          <span class="item-controls">{{#if @root.editable}}<a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>{{/if}}</span></li>
        {{/each}}
      </ol>
    </section>

    <section class="block gs-adv-mot">
      <header class="list-header"><h3>{{localize "GENESYS.Motivations"}}</h3></header>
      <div class="gs-adv-mot-grid">
        {{#each motivations}}<label>{{localize label}}<input type="text" name="system.motivations.{{key}}.name" value="{{name}}"></label>{{/each}}
      </div>
    </section>

    <section class="block editor-block">
      <header class="list-header"><h3>{{localize "GENESYS.Description"}}</h3></header>
      {{formInput systemFields.description name="system.description" enriched=enriched.description value=system.description toggled=true}}
    </section>
  </div>
</div>

<div class="sp">
  <div class="sp-side player">
    <div class="sp-head"><span>{{localize "GENESYS.StoryPoints.Players"}}</span><b class="sp-num">{{player}}</b></div>
    <div class="sp-pile">
      {{#each playerCoins}}<a class="sp-coin {{#if arrive}}arrive{{/if}}" data-action="usePlayer" data-tooltip="GENESYS.StoryPoints.UseHint"><img src="{{@root.coinPlayer}}" alt=""></a>{{/each}}
      {{#if playerMore}}<span class="sp-more">+{{playerMore}}</span>{{/if}}
      {{#unless player}}<span class="sp-empty">{{localize "GENESYS.StoryPoints.None"}}</span>{{/unless}}
    </div>
    {{#if isGM}}<div class="sp-adjust"><a data-action="adjust" data-pool="player" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="adjust" data-pool="player" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>{{/if}}
  </div>
  <div class="sp-flow"><i class="fa-solid fa-arrow-right-arrow-left"></i></div>
  <div class="sp-side gm">
    <div class="sp-head"><span>{{localize "GENESYS.StoryPoints.GM"}}</span><b class="sp-num">{{gm}}</b></div>
    <div class="sp-pile">
      {{#each gmCoins}}<a class="sp-coin {{#if arrive}}arrive{{/if}}" {{#if @root.isGM}}data-action="useGM" data-tooltip="GENESYS.StoryPoints.UseHintGM"{{/if}}><img src="{{@root.coinGM}}" alt=""></a>{{/each}}
      {{#if gmMore}}<span class="sp-more">+{{gmMore}}</span>{{/if}}
      {{#unless gm}}<span class="sp-empty">{{localize "GENESYS.StoryPoints.None"}}</span>{{/unless}}
    </div>
    {{#if isGM}}<div class="sp-adjust"><a data-action="adjust" data-pool="gm" data-delta="-1"><i class="fa-solid fa-minus"></i></a><a data-action="adjust" data-pool="gm" data-delta="1"><i class="fa-solid fa-plus"></i></a></div>{{/if}}
  </div>
</div>

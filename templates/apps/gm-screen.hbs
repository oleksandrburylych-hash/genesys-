<div class="gm">
  <nav class="gm-tabs">
    {{#each tabs}}<a class="gm-tab {{#if active}}active{{/if}}" data-action="gmTab" data-tab="{{key}}">{{localize label}}</a>{{/each}}
  </nav>

  {{#if (eq tab "encounter")}}
  <div class="gm-split">
    <div class="gm-browser">
      <div class="gm-filters">
        <select name="filter.adventure">{{#each adventures}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        <select name="filter.type"><option value="">{{localize "GENESYS.Wizard.All"}}</option>{{#each types}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
        <input type="text" name="filter.search" value="{{filter.search}}" placeholder="{{localize 'GENESYS.Wizard.Search'}}">
      </div>
      <div class="gm-list">
        {{#each list}}
        <div class="gm-row">
          <img src="{{img}}" alt="">
          <div class="gm-row-text">
            <a class="gm-row-name" data-action="open" data-uuid="{{uuid}}">{{name}}</a>
            <span class="gm-row-sub">{{type}} · {{localize "GENESYS.Wounds"}} {{wounds}} · {{localize "GENESYS.Soak"}} {{soak}}{{#if folder}} · {{folder}}{{/if}}</span>
            <span class="gm-pl" data-tooltip="GENESYS.GM.PLHint"><b class="c">⚔ {{power.combat}}</b><b class="s">✦ {{power.social}}</b><b class="g">⚙ {{power.general}}</b>{{#unless power.listed}}<i>≈</i>{{/unless}}</span>
          </div>
          <button type="button" class="gm-add" data-action="add" data-uuid="{{uuid}}"><i class="fa-solid fa-plus"></i></button>
        </div>
        {{else}}<p class="gs-empty">{{localize "GENESYS.Wizard.Nothing"}}</p>{{/each}}
      </div>
    </div>
    <div class="gm-encounter">
      <div class="gm-gen">
        <div class="gm-gen-head"><i class="fa-solid fa-dice"></i> {{localize "GENESYS.GM.Generator"}}</div>
        <div class="gm-seg">
          <a class="{{#if gen.combat}}active{{/if}}" data-action="genKindEnc" data-kind="combat">⚔ {{localize "GENESYS.GM.EncCombat"}}</a>
          <a class="{{#unless gen.combat}}active{{/unless}}" data-action="genKindEnc" data-kind="social">✦ {{localize "GENESYS.GM.EncSocial"}}</a>
        </div>
        <div class="gm-seg">
          <a class="{{#if gen.budgetMode}}active{{/if}}" data-action="genMode" data-mode="budget">{{localize "GENESYS.GM.ByDifficulty"}}</a>
          <a class="{{#unless gen.budgetMode}}active{{/unless}}" data-action="genMode" data-mode="count">{{localize "GENESYS.GM.ByCount"}}</a>
        </div>
        {{#if gen.budgetMode}}
        <div class="gm-diff">{{#each gen.difficulties}}<a class="gm-diff-btn d{{index}} {{#if active}}active{{/if}}" data-action="genDifficulty" data-index="{{index}}">{{localize label}}</a>{{/each}}</div>
        <div class="gm-gen-row"><label>{{localize "GENESYS.GM.Party"}} <input type="number" name="gen.party" value="{{gen.partySize}}" min="1" max="12"></label>
          <span class="hint">{{localize "GENESYS.GM.AvgXP"}} {{gen.avgXP}}</span></div>
        <div class="gm-cr" data-tooltip="GENESYS.GM.CRHint">
          <span>{{localize "GENESYS.GM.CR"}}</span> <b>{{gen.crBase}}</b>
          {{#each gen.mods}}<span class="gm-cr-mod">+{{value}} {{localize label}}</span>{{/each}}
          = <b class="gm-cr-total">{{gen.cr}}</b> → {{localize "GENESYS.GM.Budget"}} <b>{{gen.budget}}</b>
        </div>
        {{else}}
        <div class="gm-gen-row"><label>{{localize "GENESYS.GM.HowMany"}} <input type="number" name="gen.count" value="{{gen.count}}" min="1" max="30"></label></div>
        {{/if}}
        <div class="gm-creatures">{{#each gen.creatures}}<a class="gm-creature {{#if on}}on{{/if}}" data-action="genCreature" data-key="{{key}}" data-tooltip="{{label}}"><img src="{{img}}" alt=""><span>{{label}}</span></a>{{/each}}</div>
        <div class="gm-gen-row">{{#each gen.kinds}}<a class="wz-chip {{#if on}}active{{/if}}" data-action="genKind" data-key="{{key}}">{{localize label}}</a>{{/each}}
          <button type="button" class="gm-primary gm-gen-go" data-action="generate"><i class="fa-solid fa-wand-sparkles"></i> {{localize "GENESYS.GM.Generate"}}</button></div>
      </div>
      <div class="gs-ribbon"><span>{{localize "GENESYS.GM.Encounter"}}</span></div>
      {{#if encounter.length}}
      <div class="gm-threat {{#if gen.over}}over{{/if}}" data-tooltip="GENESYS.GM.ThreatHint"><div class="gm-threat-fill" style="width: {{gen.pct}}%"></div>
        <span>{{#if gen.combat}}⚔{{else}}✦{{/if}} {{localize "GENESYS.GM.PowerSum"}} {{gen.threat}} / {{gen.budget}} · {{localize "GENESYS.GM.Foes"}} {{gen.count}} / {{gen.partySize}}</span></div>
      {{#if gen.tooMany}}<p class="gm-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "GENESYS.GM.TooMany"}}</p>{{/if}}
      {{/if}}
      {{#each encounter}}
      <div class="gm-enc-row">
        <img src="{{img}}" alt="">
        <div class="gm-row-text">
          <span class="gm-row-name">{{name}}</span>
          {{#if minion}}
          <span class="gm-row-sub">{{localize "GENESYS.GM.GroupOf"}} <input type="number" name="enc.{{index}}.count" value="{{count}}" min="1" max="20"> · {{localize "GENESYS.GM.Groups"}}: {{groups}}</span>
          {{else}}<span class="gm-row-sub">× {{count}}</span>{{/if}}
          <span class="gm-pl"><b class="c">⚔ {{power.combat}}</b><b class="s">✦ {{power.social}}</b><b class="g">⚙ {{power.general}}</b></span>
        </div>
        <a data-action="count" data-index="{{index}}" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
        <a data-action="count" data-index="{{index}}" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        <a data-action="remove" data-index="{{index}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{else}}<p class="gs-empty">{{localize "GENESYS.GM.EncounterEmpty"}}</p>{{/each}}
      {{#if encounter.length}}
      <div class="gm-actions">
        <button type="button" data-action="place" data-combat="1" {{#unless hasScene}}disabled{{/unless}}><i class="fa-solid fa-swords"></i> {{localize "GENESYS.GM.PlaceCombat"}}</button>
        <button type="button" data-action="place" data-hidden="1" {{#unless hasScene}}disabled{{/unless}}><i class="fa-solid fa-eye-slash"></i> {{localize "GENESYS.GM.PlaceHidden"}}</button>
        <button type="button" data-action="clear"><i class="fa-solid fa-broom"></i> {{localize "GENESYS.GM.Clear"}}</button>
      </div>
      {{/if}}
      <p class="hint">{{localize "GENESYS.GM.EncounterHint"}}</p>
      <div class="gm-actions">
        <button type="button" data-action="fear"><i class="fa-solid fa-ghost"></i> {{localize "GENESYS.Fear.Title"}}</button>
        <button type="button" data-action="social"><i class="fa-solid fa-comments"></i> {{localize "GENESYS.Social.Title"}}</button>
      </div>
    </div>
  </div>
  {{/if}}

  {{#if (eq tab "loot")}}
  <div class="gm-body">
    <div class="gm-seg">{{#each loot.sources}}<a class="{{#if active}}active{{/if}}" data-action="lootSource" data-key="{{key}}">{{localize label}}</a>{{/each}}</div>
    <p class="hint">{{localize (concat "GENESYS.Loot.SourceHint." loot.source)}} — {{loot.sourceCount}}</p>
    <div class="gm-loot-levels">
      {{#each loot.levels}}
      <a class="gm-loot-level l{{level}} {{#if active}}active{{/if}}" data-action="lootLevel" data-level="{{level}}">
        <img src="{{img}}" alt=""><b>{{localize label}}</b><small>{{localize hint}}</small>
      </a>
      {{/each}}
    </div>
    <div class="gm-actions"><button type="button" class="gm-primary" data-action="lootGenerate"><i class="fa-solid fa-dice"></i> {{#if loot.result}}{{localize "GENESYS.Loot.Reroll"}}{{else}}{{localize "GENESYS.Loot.Generate"}}{{/if}}</button></div>
    {{#if loot.result}}
    <div class="gm-loot-result">
      <div class="gm-loot-coins"><i class="fa-solid fa-coins"></i> <b>{{loot.result.coins}}</b> {{localize "GENESYS.Loot.Coins"}}</div>
      {{#each loot.result.items}}
      <div class="gm-enc-row"><img src="{{img}}" alt=""><div class="gm-row-text"><span class="gm-row-name">{{name}}{{#if (gt qty 1)}} ×{{qty}}{{/if}}</span>
        <span class="gm-row-sub">{{#if origin}}{{origin}} · {{/if}}{{total}}</span></div>
        <a data-action="lootRemove" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></a></div>
      {{else}}<p class="gs-empty">{{localize "GENESYS.Loot.NoItems"}}</p>{{/each}}
      <p class="hint">{{localize "GENESYS.Loot.Value"}}: {{loot.result.value}}</p>
      <div class="gm-actions"><button type="button" class="gm-primary" data-action="lootToChat"><i class="fa-solid fa-comment-dollar"></i> {{localize "GENESYS.Loot.ToChat"}}</button></div>
    </div>
    {{/if}}
    <p class="hint">{{localize "GENESYS.Loot.Hint"}}</p>
  </div>
  {{/if}}

  {{#if (eq tab "shop")}}
  <div class="gm-body">
    <div class="gm-gen-row"><label>{{localize "GENESYS.Shop.Name"}} <input type="text" name="shop.name" value="{{shop.name}}" placeholder="{{localize 'GENESYS.Shop.NamePh'}}"></label>
      <label>{{localize "GENESYS.Wizard.Adventure"}} <select name="shop.adventure">{{#each shop.adventures}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
    <div class="gm-shop-types">{{#each shop.types}}<a class="gm-creature {{#if active}}on{{/if}}" data-action="shopType" data-key="{{key}}"><img src="{{img}}" alt=""><span>{{localize label}}</span></a>{{/each}}</div>
    <div class="gm-gen-row"><div class="gm-seg">{{#each shop.sizes}}<a class="{{#if active}}active{{/if}}" data-action="shopSize" data-key="{{key}}">{{localize label}}</a>{{/each}}</div></div>
    <div class="gs-ribbon"><span>{{localize "GENESYS.Shop.Where"}} ({{localize "GENESYS.Rarity"}} {{shop.locMod}})</span></div>
    <div class="gm-locs">{{#each shop.locs}}<a class="wz-chip {{#if on}}active{{/if}}" data-action="shopLoc" data-key="{{key}}">{{localize label}} {{value}}</a>{{/each}}</div>
    <div class="gm-actions"><button type="button" class="gm-primary" data-action="shopGenerate"><i class="fa-solid fa-store"></i> {{#if shop.items}}{{localize "GENESYS.Loot.Reroll"}}{{else}}{{localize "GENESYS.Shop.Generate"}}{{/if}}</button></div>
    {{#if shop.items}}
    {{#each shop.items}}
    <div class="gm-enc-row"><img src="{{img}}" alt=""><div class="gm-row-text"><span class="gm-row-name">{{name}}</span>
      <span class="gm-row-sub">{{price}} · {{localize "GENESYS.Rarity"}} {{rarity}} · {{check}}{{#if restricted}} · (R){{/if}} · {{localize "GENESYS.Shop.Stock"}} {{stock}}</span></div>
      <a data-action="shopRemove" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></a></div>
    {{/each}}
    <div class="gm-actions"><button type="button" class="gm-primary" data-action="shopToChat"><i class="fa-solid fa-comment-dollar"></i> {{localize "GENESYS.Shop.ToChat"}}</button></div>
    {{/if}}
    <p class="hint">{{localize "GENESYS.Shop.Hint"}}</p>
  </div>
  {{/if}}

  {{#if (eq tab "npc")}}
  <div class="gm-body gm-npc">
    <div class="gm-npc-form">
      <label>{{localize "GENESYS.Wizard.Adventure"}}<select name="npc.adventure">{{#each npc.adventures}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "GENESYS.NPC.Role"}}<select name="npc.role">{{#each npc.roles}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "GENESYS.AdversaryType.label"}}<select name="npc.kind">{{#each npc.kinds}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}</select></label>
      <label>{{localize "GENESYS.NPC.PowerLabel"}}<select name="npc.power">
        <option value="1" {{#if (eq npc.power 1)}}selected{{/if}}>{{localize "GENESYS.NPC.Power.1"}}</option>
        <option value="2" {{#if (eq npc.power 2)}}selected{{/if}}>{{localize "GENESYS.NPC.Power.2"}}</option>
        <option value="3" {{#if (eq npc.power 3)}}selected{{/if}}>{{localize "GENESYS.NPC.Power.3"}}</option></select></label>
    </div>
    <div class="gm-actions"><button type="button" class="gm-primary" data-action="npcGenerate"><i class="fa-solid fa-user-plus"></i> {{localize "GENESYS.NPC.Generate"}}</button></div>
    {{#if npc.last}}<div class="gm-enc-row"><img src="{{npc.last.img}}" alt=""><div class="gm-row-text"><a class="gm-row-name" data-action="open" data-uuid="{{npc.last.uuid}}">{{npc.last.name}}</a><span class="gm-row-sub">{{localize "GENESYS.NPC.Created"}}</span></div></div>{{/if}}
    <p class="hint">{{localize "GENESYS.NPC.Hint"}}</p>
  </div>
  {{/if}}

  {{#if (eq tab "xp")}}
  <div class="gm-body">
    <div class="gm-chars">
      {{#each characters}}
      <a class="gm-char {{#if on}}on{{/if}}" data-action="toggleChar" data-id="{{id}}">
        <img src="{{img}}" alt=""><span><b>{{name}}</b><small>{{localize "GENESYS.GM.XPAvailable"}} {{available}} / {{total}}</small></span>
        <i class="fa-solid {{#if on}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
      </a>
      {{else}}<p class="gs-empty">{{localize "GENESYS.GM.NoCharacters"}}</p>{{/each}}
    </div>
    <div class="gm-xp-form">
      <label>{{localize "GENESYS.GM.XPAmount"}} <input type="number" name="xp.amount" value="{{xp.amount}}" min="0"></label>
      <label class="wide">{{localize "GENESYS.GM.XPReason"}} <input type="text" name="xp.reason" value="{{xp.reason}}" placeholder="{{localize 'GENESYS.GM.XPDefault'}}"></label>
    </div>
    <div class="gm-actions">
      {{#each presets}}<button type="button" data-action="award" data-amount="{{this}}">+{{this}}</button>{{/each}}
      <button type="button" class="gm-primary" data-action="award"><i class="fa-solid fa-star"></i> {{localize "GENESYS.GM.Award"}}</button>
    </div>
    <p class="hint">{{localize "GENESYS.GM.XPHint"}}</p>
  </div>
  {{/if}}

  {{#if (eq tab "interp")}}
  <div class="gm-body gm-interp">
    <div class="gm-interp-top">
      <div class="gm-seg gm-interp-eras">{{#each interp.eras}}<a class="{{#if active}}active{{/if}}" data-action="interpEra" data-key="{{key}}"><i class="{{icon}}"></i> {{localize label}}</a>{{/each}}</div>
      <a class="gm-interp-whisper {{#if interp.whisper}}on{{/if}}" data-action="interpWhisper" data-tooltip="GENESYS.Interp.WhisperHint">
        <i class="fa-solid {{#if interp.whisper}}fa-user-secret{{else}}fa-users{{/if}}"></i> {{#if interp.whisper}}{{localize "GENESYS.Interp.ToGM"}}{{else}}{{localize "GENESYS.Interp.ToAll"}}{{/if}}</a>
    </div>
    <div class="gm-interp-skills">
      {{#each interp.groups}}
      <div class="gm-interp-group"><b>{{localize label}}</b>{{#each skills}}<a class="wz-chip {{#if active}}active{{/if}}" data-action="interpSkill" data-key="{{key}}">{{label}}</a>{{/each}}</div>
      {{/each}}
    </div>
    <p class="hint">{{localize "GENESYS.Interp.Hint"}}</p>
    {{#if interp.missing}}
    <p class="gs-warning"><i class="fa-solid fa-circle-info"></i> {{localize "GENESYS.Interp.Missing"}} {{#if interp.otherEras}}({{interp.otherEras}}){{/if}}</p>
    {{else}}
    <div class="gm-interp-cols">
      {{#each interp.columns}}
      <section class="gm-interp-col {{key}}">
        <header>{{#if mixed}}<span class="genesys-symbol triumph"></span><span class="genesys-symbol despair"></span>{{else}}<span class="genesys-symbol {{key}}"></span>{{/if}} {{localize label}}{{#if mixed}} <small>{{localize "GENESYS.Interp.MixedHint"}}</small>{{/if}}
          <a class="gm-interp-dice" data-action="interpRandom" data-outcome="{{key}}" data-tooltip="GENESYS.Interp.Random"><i class="fa-solid fa-dice"></i></a></header>
        <ol>{{#each items}}<li class="{{#if hl}}hl{{/if}}" data-action="interpPick" data-outcome="{{../key}}" data-index="{{i}}">{{text}}</li>{{/each}}</ol>
      </section>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{#if (eq tab "reference")}}
  <div class="gm-body gm-ref">
    <div class="gm-ref-cols">
      <div>
        <div class="gs-ribbon"><span>{{localize "GENESYS.Difficulty.label"}}</span></div>
        <table class="gm-table">{{#each difficulties}}<tr><td>{{localize label}}</td><td>{{#times n}}<span class="gm-die difficulty"></span>{{/times}}</td></tr>{{/each}}</table>
        <div class="gs-ribbon"><span>{{localize "GENESYS.Range.label"}}</span></div>
        <table class="gm-table">{{#each ranges}}<tr><td>{{localize label}}</td><td class="hint">{{localize hint}}</td></tr>{{/each}}</table>
      </div>
      <div>
        <div class="gs-ribbon"><span>{{localize "GENESYS.GM.Statuses"}}</span></div>
        <table class="gm-table">{{#each statuses}}<tr><td><img src="{{img}}" alt="" class="gm-status-img"> {{localize name}}</td><td class="hint">{{localize hint}}</td></tr>{{/each}}</table>
      </div>
    </div>
    <div class="gs-ribbon"><span>{{localize "GENESYS.GM.Spending"}}</span></div>
    <div class="gm-filters">{{#each refTables}}<a class="wz-chip {{#if active}}active{{/if}}" data-action="refTable" data-table="{{key}}">{{title}}</a>{{/each}}</div>
    <table class="gm-table">{{#each refRows}}<tr><td class="gm-cost">{{cost}}</td><td>{{text}}</td></tr>{{/each}}</table>
  </div>
  {{/if}}
</div>

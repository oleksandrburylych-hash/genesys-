<section class="item-details heroic-details">
  <div class="grid-2">
    <div class="form-group"><label>{{localize "GENESYS.Activation.label"}}</label>
      <select name="system.activation">{{selectOptions choices.activations selected=system.activation localize=true}}</select></div>
    <div class="form-group"><label>{{localize "GENESYS.Heroic.Cost"}}</label>
      <input type="text" name="system.cost" value="{{system.cost}}"></div>
  </div>
  <p class="hint">{{localize "GENESYS.Heroic.Rules"}}</p>
  {{#if heroicPoints}}<p><strong>{{localize "GENESYS.Heroic.Points"}}:</strong> {{heroicPoints.available}} / {{heroicPoints.total}}</p>{{/if}}
  <header class="list-header">
    <h4>{{localize "GENESYS.Heroic.Upgrades"}}</h4>
    {{#if editable}}<a class="item-control" data-action="addRow" data-field="system.upgrades"><i class="fa-solid fa-plus"></i></a>{{/if}}
  </header>
  <ol class="effect-editor">
    {{#each system.upgrades}}
    <li class="effect-row {{#if count}}chosen{{/if}}">
      <div class="effect-row-top">
        <input type="text" name="system.upgrades.{{@index}}.name" value="{{name}}">
        <input type="number" name="system.upgrades.{{@index}}.cost" value="{{cost}}" min="0" data-dtype="Number" data-tooltip="GENESYS.Heroic.UpgradeCost">
        <input type="number" name="system.upgrades.{{@index}}.max" value="{{max}}" min="0" data-dtype="Number" data-tooltip="GENESYS.Heroic.UpgradeMax">
        <span class="upgrade-count">×{{count}}</span>
        {{#if @root.owned}}
        <a data-action="buyUpgrade" data-index="{{@index}}" data-delta="-1" data-tooltip="GENESYS.Heroic.Refund"><i class="fa-solid fa-minus"></i></a>
        <a data-action="buyUpgrade" data-index="{{@index}}" data-delta="1" data-tooltip="GENESYS.Heroic.Buy"><i class="fa-solid fa-plus"></i></a>
        {{/if}}
        {{#if @root.editable}}<a data-action="removeRow" data-field="system.upgrades" data-index="{{@index}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </div>
      <textarea name="system.upgrades.{{@index}}.description" rows="2">{{description}}</textarea>
    </li>
    {{/each}}
  </ol>
</section>

<section class="item-details grid-2">
  <div class="form-group"><label>{{localize "GENESYS.Talent.Tier"}}</label>
    <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="5" data-dtype="Number"></div>
  <div class="form-group"><label>{{localize "GENESYS.Activation.label"}}</label>
    <select name="system.activation">{{selectOptions choices.activations selected=system.activation localize=true}}</select></div>
  <div class="form-group"><label>{{localize "GENESYS.Talent.Ranked"}}</label>
    <input type="checkbox" name="system.ranked" {{checked system.ranked}}></div>
  {{#if system.ranked}}
  <div class="form-group"><label>{{localize "GENESYS.Rank"}}</label>
    <input type="number" name="system.rank" value="{{system.rank}}" min="1" data-dtype="Number"></div>
  {{/if}}
</section>

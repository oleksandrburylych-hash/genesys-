<section class="item-details grid-2">
  <div class="form-group"><label>{{localize "GENESYS.Injury.Severity"}}</label>
    <input type="number" name="system.severity" value="{{system.severity}}" min="0" max="5" data-dtype="Number"></div>
  <div class="form-group"><label>{{localize "GENESYS.Injury.Range"}}</label>
    <input type="text" name="system.rollRange" value="{{system.rollRange}}" placeholder="01–05"></div>
  <div class="form-group"><label>{{localize "GENESYS.Injury.Setback"}}</label>
    <input type="number" name="system.setback" value="{{system.setback}}" min="0" max="5" data-dtype="Number" data-tooltip="GENESYS.Injury.SetbackHint"></div>
</section>
